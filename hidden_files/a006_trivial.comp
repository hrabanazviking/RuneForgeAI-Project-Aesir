#version 450
// A-006 trivial compute shader: out[i] = in[i] + 1.0 (readiness proof only).
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer InBuf { float data_in[]; };
layout(set = 0, binding = 1) buffer OutBuf { float data_out[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < data_in.length()) {
        data_out[i] = data_in[i] + 1.0;
    }
}
