#version 450
layout(local_size_x=256) in;
layout(std430, binding=0) readonly buffer B { uint v[]; } b;
layout(std430, binding=1) buffer O { uint s[]; } o;
shared uint sh[256];
void main(){ uint i = gl_GlobalInvocationID.x; sh[gl_LocalInvocationID.x] = b.v[i]; barrier();
 for(uint r=128;r>0;r>>=1){ if(gl_LocalInvocationID.x<r) sh[gl_LocalInvocationID.x]+=sh[gl_LocalInvocationID.x+r]; barrier(); }
 if(gl_LocalInvocationID.x==0) o.s[gl_WorkGroupID.x]=sh[0]; }
