# core/vulkan_elementwise.mojo
# VulkanElementwise: Vulkan elementwise + softmax gateway (A-061).
#
# SiLU / mul / add (residual) / gated-SiLU dispatched on the GPU
# through the A-014/A-015 Vulkan context and buffer slots, plus an
# in-place row softmax whose kernel subtracts the row maximum
# before exponentiation. The kernels are the A-055 foundation
# shaders (aesir_engine/shaders/elementwise.comp and softmax.comp,
# SPIR-V generated by scripts/build_shaders.py and embedded via
# aesir_engine/shaders/generated/aesir_shaders_spv.h, hashes in
# aesir_engine/shaders/SHADER_MANIFEST.json); this slice wires
# their dispatch through aesir_engine/vulkan_buffer_shim.c in the
# A-056/A-058/A-060 pattern - pipeline per call, submit,
# queue-wait-idle.
#
# Fail-closed contract (matches A-014/A-015/A-056/A-058/A-060):
# when the Vulkan runtime or the RADV device is unavailable every
# operation raises; no host fallback is fabricated. Sizes must be
# positive, elementwise modes are 0..3, and every buffer must
# cover the full operand; violations raise before any dispatch.
# elementwise_dispatch_count() / softmax_dispatch_count() read
# the shim counters that increment only after a submit +
# queue-wait-idle completed on the device - the filed
# device-execution evidence (law 6).

from std.ffi import external_call
from core.vulkan_buffers import VulkanBuffers, VulkanAllocation

comptime _VK_ABSENT = -1000000
comptime _VK_INVALID = -1000001


struct VulkanElementwise:
    """Static Vulkan elementwise + softmax gateway (A-061)."""

    @staticmethod
    def _raise_for_rc(what: String, rc: Int32) raises:
        if Int(rc) == _VK_ABSENT:
            raise Error(
                "GPU-002 DEVICE_NOT_FOUND: VulkanElementwise." + what + ": Vulkan loader or dispatch"
                " entry points are not loadable on this host"
                " (honest-absent)"
            )
        if Int(rc) == _VK_INVALID:
            raise Error(
                "VAL-003 VALUE_OUT_OF_RANGE: VulkanElementwise." + what + ": invalid buffer id or"
                " argument for the Vulkan shim"
            )
        raise Error(
            "GPU-001 CUDA_INIT_FAILED: VulkanElementwise." + what + ": Vulkan call failed, VkResult "
            + String(Int(rc))
        )

    @staticmethod
    def elementwise(
        a: VulkanAllocation,
        b: VulkanAllocation,
        y: VulkanAllocation,
        n: Int,
        mode: Int,
    ) raises:
        """Dispatch the A-061 elementwise kernel over n Float32:
        mode 0 y = silu(a), mode 1 y = a * b, mode 2 y = a + b
        (residual add), mode 3 y = silu(a) * b (gated SiLU).
        a, b and y each hold n Float32 (b is bound but unread in
        mode 0). n must be positive and mode must be in 0..3.
        The shim submits and waits for the queue to go idle, so a
        mapped read of y after this call observes the completed
        dispatch. Raises (fail-closed) on any violation or
        Vulkan failure - nothing is computed on the host."""
        if n <= 0:
            raise Error("VAL-003 VALUE_OUT_OF_RANGE: VulkanElementwise.elementwise: element count n must be positive")
        if mode < 0 or mode > 3:
            raise Error("VAL-003 VALUE_OUT_OF_RANGE: VulkanElementwise.elementwise: mode must be in 0..3 (silu, mul, add, gated silu)")
        if a.requested_size < n * 4:
            raise Error("VAL-003 VALUE_OUT_OF_RANGE: VulkanElementwise.elementwise: input buffer a is smaller than n Float32")
        if b.requested_size < n * 4:
            raise Error("VAL-003 VALUE_OUT_OF_RANGE: VulkanElementwise.elementwise: input buffer b is smaller than n Float32")
        if y.requested_size < n * 4:
            raise Error("VAL-003 VALUE_OUT_OF_RANGE: VulkanElementwise.elementwise: output buffer y is smaller than n Float32")
        var rc = external_call["aesir_vk_buffer_elementwise", Int32](
            UInt64(a.id), UInt64(b.id), UInt64(y.id), UInt32(n), UInt32(mode)
        )
        if rc != 0:
            Self._raise_for_rc("elementwise", rc)

    @staticmethod
    def softmax(
        x: VulkanAllocation,
        n: Int,
        rows: Int,
    ) raises:
        """Dispatch the A-061 softmax kernel in place over x:
        rows independent rows of n Float32; each row is replaced
        by softmax(row) computed with the row maximum subtracted
        before exponentiation (numerically careful form). n and
        rows must be positive and x must hold rows * n Float32.
        The shim submits and waits idle before returning. Raises
        (fail-closed) on any violation or Vulkan failure."""
        if n <= 0:
            raise Error("VAL-003 VALUE_OUT_OF_RANGE: VulkanElementwise.softmax: row length n must be positive")
        if rows <= 0:
            raise Error("VAL-003 VALUE_OUT_OF_RANGE: VulkanElementwise.softmax: row count must be positive")
        if x.requested_size < rows * n * 4:
            raise Error("VAL-003 VALUE_OUT_OF_RANGE: VulkanElementwise.softmax: buffer is smaller than rows*n Float32")
        var rc = external_call["aesir_vk_buffer_softmax", Int32](
            UInt64(x.id), UInt32(n), UInt32(rows)
        )
        if rc != 0:
            Self._raise_for_rc("softmax", rc)

    @staticmethod
    def elementwise_dispatch_count() -> Int:
        """Completed A-061 elementwise dispatches on the device
        so far (shim counter; increments only after submit +
        wait-idle)."""
        return Int(external_call["aesir_vk_elementwise_dispatch_count", UInt64]())

    @staticmethod
    def softmax_dispatch_count() -> Int:
        """Completed A-061 softmax dispatches on the device so
        far (shim counter; increments only after submit +
        wait-idle)."""
        return Int(external_call["aesir_vk_softmax_dispatch_count", UInt64]())
