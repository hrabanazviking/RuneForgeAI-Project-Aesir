"""Vulkan decode attention (A-062): single-query attention over
a unified KV cache dispatched on the GPU through the A-014/A-015
Vulkan context, judged against an independent CPU attention
reference written in this file.

Parity discipline (raw-oracle law): expected values come ONLY
from the sequential Float32 CPU reference below - never from
the shader, its wrapper, or any golden generated by them. The
reference implements the textbook definition directly:
score_t = (q . k_t) / sqrt(head_dim); softmax with
max-subtraction over t in [0, kv_len); o_d = sum_t w_t * v_t,d;
query head h reads KV head h // kv_per_query (grouped-query
mapping). The GPU kernel accumulates in the same t order, so
the filed tolerance (1e-4 abs) is an exp/division rounding
bound, printed per shape for the ledger.

Coverage: multiple head counts (4, 8, 16, 24), head dims
(32, 64, 128), KV lengths (1, 5, 17, 33, 37, 64, 129, 1024),
and GQA ratios 1 (MHA), 2, 3 (the repo fixture ratio:
24 query heads / 8 KV heads in core/fused_causal_attention.mojo
and core/fused_small_attention.mojo), 4, and 8 (MQA).

Device-execution evidence (law 6): the selected device must be
the AMD Radeon 8060S (RADV STRIX_HALO) - llvmpipe is refused by
the identity check - and the shim dispatch counter must
advance by exactly the number of dispatches performed. On a
host without that device the parity cases assert fail-closed
behaviour and pass as honest-absent, matching A-014 discipline.
"""
from std.math import exp, sqrt
from core.vulkan_buffers import VulkanBuffers, VulkanAllocation
from core.vulkan_attention import VulkanAttention


def _vk_present() -> Bool:
    if not VulkanBuffers.runtime_available():
        return False
    if not VulkanBuffers.dispatch_available():
        return False
    try:
        var info = VulkanBuffers.device_info()
        if info.vendor_id != 0x1002:
            return False
        if info.device_type == 4:
            return False
        return VulkanBuffers.device_name_is_radv()
    except:
        return False


struct _Lcg:
    var state: UInt64

    def __init__(out self, seed: UInt64):
        self.state = seed

    def next(mut self) -> UInt64:
        self.state = (
            self.state * 6364136223846793005 + 1442695040888963407
        )
        return self.state >> 11

    def unit(mut self) -> Float32:
        return Float32(self.next() & 0xFFFFFF) / Float32(16777216.0)

    def val(mut self) -> Float32:
        return self.unit() * Float32(2.0) - Float32(1.0)


def _cpu_oracle(
    qs: List[Float32],
    ks: List[Float32],
    vs: List[Float32],
    head_dim: Int,
    kv_len: Int,
    num_heads: Int,
    kv_per_query: Int,
) -> List[Float32]:
    """Independent sequential CPU decode attention reference."""
    var out = List[Float32]()
    var scale = Float32(1.0) / sqrt(Float32(head_dim))
    for h in range(num_heads):
        var kv_head = h // kv_per_query
        var scores = List[Float32]()
        var top = Float32(-1.0e30)
        for t in range(kv_len):
            var s = Float32(0.0)
            var kbase = (kv_head * kv_len + t) * head_dim
            for d in range(head_dim):
                s += qs[h * head_dim + d] * ks[kbase + d]
            s = s * scale
            scores.append(s)
            if s > top:
                top = s
        var denom = Float32(0.0)
        var ws = List[Float32]()
        for t in range(kv_len):
            var w = exp(scores[t] - top)
            ws.append(w)
            denom += w
        for d in range(head_dim):
            var acc = Float32(0.0)
            for t in range(kv_len):
                var kbase = (kv_head * kv_len + t) * head_dim
                acc += ws[t] * vs[kbase + d]
            out.append(acc / denom)
    return out^


def _shape_parity(
    num_heads: Int,
    kv_per_query: Int,
    head_dim: Int,
    kv_len: Int,
    seed: UInt64,
) raises -> Float32:
    """One shape vs the CPU oracle; returns max abs delta."""
    var num_kv_heads = num_heads // kv_per_query
    var q_n = num_heads * head_dim
    var kv_n = num_kv_heads * kv_len * head_dim
    var lcg = _Lcg(seed)
    var qs = List[Float32]()
    var ks = List[Float32]()
    var vs = List[Float32]()
    for _ in range(q_n):
        qs.append(lcg.val())
    for _ in range(kv_n):
        ks.append(lcg.val())
    for _ in range(kv_n):
        vs.append(lcg.val())
    var expected = _cpu_oracle(qs, ks, vs, head_dim, kv_len, num_heads, kv_per_query)
    var q_alloc = VulkanBuffers.allocate(q_n * 4)
    var k_alloc = VulkanBuffers.allocate(kv_n * 4)
    var v_alloc = VulkanBuffers.allocate(kv_n * 4)
    var o_alloc = VulkanBuffers.allocate(q_n * 4)
    var pq = VulkanBuffers.map(q_alloc)
    var fq = pq.unsafe_bitcast[Float32]()
    for i in range(q_n):
        fq.unsafe_store(i, qs[i])
    VulkanBuffers.unmap(q_alloc)
    var pk = VulkanBuffers.map(k_alloc)
    var fk = pk.unsafe_bitcast[Float32]()
    for i in range(kv_n):
        fk.unsafe_store(i, ks[i])
    VulkanBuffers.unmap(k_alloc)
    var pv = VulkanBuffers.map(v_alloc)
    var fv = pv.unsafe_bitcast[Float32]()
    for i in range(kv_n):
        fv.unsafe_store(i, vs[i])
    VulkanBuffers.unmap(v_alloc)
    var po = VulkanBuffers.map(o_alloc)
    var fo = po.unsafe_bitcast[Float32]()
    for i in range(q_n):
        fo.unsafe_store(i, Float32(-9999.0))
    VulkanBuffers.unmap(o_alloc)
    VulkanAttention.decode_attention(
        q_alloc, k_alloc, v_alloc, o_alloc,
        head_dim, kv_len, num_heads, kv_per_query,
    )
    var max_abs = Float32(0.0)
    var qo = VulkanBuffers.map(o_alloc)
    var go = qo.unsafe_bitcast[Float32]()
    for i in range(q_n):
        var got = go.unsafe_load(i)
        var delta = got - expected[i]
        if delta < Float32(0.0):
            delta = -delta
        if delta > max_abs:
            max_abs = delta
    VulkanBuffers.unmap(o_alloc)
    VulkanBuffers.free(q_alloc)
    VulkanBuffers.free(k_alloc)
    VulkanBuffers.free(v_alloc)
    VulkanBuffers.free(o_alloc)
    print(
        "attn shape heads=" + String(num_heads)
        + " ratio=" + String(kv_per_query)
        + " dim=" + String(head_dim)
        + " kv=" + String(kv_len)
        + " max_abs=" + String(max_abs)
    )
    return max_abs


def _check_shape(
    num_heads: Int,
    kv_per_query: Int,
    head_dim: Int,
    kv_len: Int,
    seed: UInt64,
) raises:
    var max_abs = _shape_parity(num_heads, kv_per_query, head_dim, kv_len, seed)
    if max_abs > Float32(1.0e-4):
        raise Error(
            "decode attention parity failed: max_abs " + String(max_abs)
            + " above the filed 1e-4 rounding bound"
        )


def test_vulkan_attn_decode_oracle_parity() raises:
    print("--- Testing Vulkan decode attention oracle parity (A-062) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: parity not run (honest-absent)")
        return
    _check_shape(4, 1, 32, 5, 0xA06201)
    _check_shape(8, 2, 64, 17, 0xA06202)
    _check_shape(16, 4, 128, 129, 0xA06203)
    _check_shape(8, 8, 64, 64, 0xA06204)
    _check_shape(8, 2, 64, 1024, 0xA06205)
    _check_shape(4, 1, 128, 1, 0xA06206)
    print("Vulkan decode attention oracle parity (6 shapes, MHA/GQA/MQA): PASS")


def test_vulkan_attn_decode_known_value() raises:
    print("--- Testing Vulkan decode attention known values (A-062) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: known values not run (honest-absent)")
        return
    # kv_len == 1: softmax weight is exactly 1, so o == v row.
    var max_abs = _shape_parity(4, 2, 32, 1, 0xA06211)
    if max_abs > Float32(1.0e-6):
        raise Error("kv_len=1 known value failed: o must equal the single v row")
    print("Vulkan decode attention known values (kv_len=1 identity): PASS")


def test_vulkan_attn_decode_gqa_fixture() raises:
    print("--- Testing Vulkan decode attention GQA fixture ratio (A-062) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: GQA fixture not run (honest-absent)")
        return
    # Repo fixture geometry: 24 query heads / 8 KV heads (ratio 3),
    # head_dim 128 (core/fused_causal_attention.mojo), odd KV length.
    _check_shape(24, 3, 128, 37, 0xA06221)
    _check_shape(24, 3, 64, 128, 0xA06222)
    print("Vulkan decode attention GQA fixture ratio 3 (24/8): PASS")


def test_vulkan_attn_decode_rejection() raises:
    print("--- Testing Vulkan decode attention rejection (A-062) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: rejection cases not run (honest-absent)")
        return
    var q_alloc = VulkanBuffers.allocate(4 * 32 * 4)
    var rejected = 0
    # Zero / negative shapes raise in the gateway before dispatch.
    try:
        VulkanAttention.decode_attention(q_alloc, q_alloc, q_alloc, q_alloc, 0, 4, 4, 1)
    except:
        rejected += 1
    try:
        VulkanAttention.decode_attention(q_alloc, q_alloc, q_alloc, q_alloc, 32, 0, 4, 1)
    except:
        rejected += 1
    try:
        VulkanAttention.decode_attention(q_alloc, q_alloc, q_alloc, q_alloc, 32, 4, 0, 1)
    except:
        rejected += 1
    try:
        VulkanAttention.decode_attention(q_alloc, q_alloc, q_alloc, q_alloc, 32, 4, 4, 0)
    except:
        rejected += 1
    # Non-integer GQA ratio (6 heads, ratio 4) must raise.
    try:
        VulkanAttention.decode_attention(q_alloc, q_alloc, q_alloc, q_alloc, 32, 4, 6, 4)
    except:
        rejected += 1
    # Undersized buffers must raise (valid shape, tiny buffers).
    try:
        VulkanAttention.decode_attention(q_alloc, q_alloc, q_alloc, q_alloc, 32, 64, 8, 2)
    except:
        rejected += 1
    VulkanBuffers.free(q_alloc)
    if rejected != 6:
        raise Error("rejection failed: " + String(rejected) + " of 6 invalid calls raised")
    print("Vulkan decode attention rejection (6 invalid calls): PASS")


def test_vulkan_attn_decode_dispatch_evidence() raises:
    print("--- Testing Vulkan decode attention dispatch evidence (A-062) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: dispatch evidence not run (honest-absent)")
        return
    var before = VulkanAttention.dispatch_count()
    var base_bytes = VulkanBuffers.live_bytes()
    var base_count = VulkanBuffers.live_count()
    _ = _shape_parity(8, 2, 64, 17, 0xA06231)
    _ = _shape_parity(8, 2, 64, 17, 0xA06231)
    var after = VulkanAttention.dispatch_count()
    if after - before != 2:
        raise Error(
            "dispatch counter advanced by " + String(after - before)
            + " for 2 dispatches (device-execution evidence broken)"
        )
    if VulkanBuffers.live_bytes() != base_bytes:
        raise Error("decode attention loop leaked device bytes")
    if VulkanBuffers.live_count() != base_count:
        raise Error("decode attention loop leaked buffers")
    print("Vulkan decode attention dispatch evidence (counter +2, accounting exact): PASS")
