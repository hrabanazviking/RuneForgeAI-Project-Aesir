def _gpu_optimum() -> String:
    return String(
        "MEASURED_OPTIMUM_A098: at 128x1024x1024 the GPU is"
        " fastest (67.5 us) and the perf-per-watt winner"
        " (51.20 GFLOP/s/W gross vs NPU 5.39, CPU 5.34);"
        " first-class GPU backend per A-086"
    )


def _prefill_gpu_line() -> String:
    return (
        String("prefill_projection -> GPU (Vulkan): ")
        + _gpu_optimum()
        + " [measured est 67.5 us]"
    )


def _prefill_band_line() -> String:
    return String("prefill_projection -> GPU (Vulkan): ") + _gpu_optimum()


def _embproj_gpu_line() -> String:
    return (
        String("embedding_projection -> GPU (Vulkan): ")
        + _gpu_optimum()
        + " [measured est 67.5 us]"
    )


def _capped_line() -> String:
    return String(
        "prefill_projection -> NPU (XRT): POWER_CAPPED_A098:"
        " NPU package draw is 22.1 W vs GPU 77.7 W at this"
        " shape class and its net-of-idle J/op beats CPU"
        " (0.0298 vs 0.0446); under a power cap that is the"
        " measured optimum [measured est 2258.2 us]"
        " [fallback: CPU (A-099 FALLBACK_<NAME>)]"
    )


def _overlap_line() -> String:
    return String(
        "prefill_projection -> NPU (XRT): OVERLAP_A096: NPU"
        " prefill computed inside the GPU decode shadow was"
        " fully hidden (median benefit 4,198 us over serial);"
        " overlapped, the NPU is the optimum [fallback: CPU"
        " (A-099 FALLBACK_<NAME>)]"
    )


def _gemm_line() -> String:
    return String(
        "gemm -> CPU (CPU): BELOW_FLOOR_A094: under ~0.1M"
        " MACs the 93.0 us NPU dispatch floor dominates"
        " (32x32x32 measured NPU 93.0 us vs CPU oracle 27.2"
        " us, 0.29x) [measured est 27.2 us]"
    )


def _gemv_gpu_line() -> String:
    return String(
        "gemv -> GPU (Vulkan): NOT_FIT_A094: decode GEMV"
        " (M=1) is not expressible in the stood-up NPU design"
        " (tile M=32) and per-op dispatch would cost ~19"
        " ms/token across 32 layers; the Vulkan decode road"
        " owns decode"
    )


def _sampling_line() -> String:
    return String(
        "sampling -> CPU (CPU): MEASURED_A097: NPU argmax"
        " loses to the CPU scan at both vocab sizes (104.8"
        " vs 19.9 us at V=32768; 165.2 vs 76.7 us at"
        " V=131072) -- floor-bound, NOT FIT on NPU"
        " [measured est 76.7 us]"
    )


def _attention_gpu_line() -> String:
    return String(
        "attention -> GPU (Vulkan): A017_CLASS: attention is"
        " memory-bound over the KV cache and is not"
        " NPU-shaped in this engine; the Vulkan attention"
        " road owns it"
    )


def _embed_line() -> String:
    return String(
        "embedding_lookup -> CPU (CPU): NOT_FIT_A094:"
        " embedding lookup is a gather with no arithmetic;"
        " no NPU crossover exists"
    )


def _elementwise_line() -> String:
    return String(
        "elementwise -> CPU (CPU): FUSION_ONLY_A094:"
        " standalone elementwise can never repay the 93.0 us"
        " NPU dispatch floor at decode sizes; value only"
        " fused inside a resident GEMM design"
    )


def _transfer_gpu_line() -> String:
    return String(
        "transfer -> GPU (Vulkan): A017_POLICY_DELEGATE (no"
        " A-100 measured row): skip NPU (NPU present (XRT)"
        " but no NPU execution is proven yet -- presence"
        " only, not placement). Vulkan GPU backend available"
        " (bake-off winner, first-class)"
    )


def _fake(found: Bool, device: String) -> RawBackendProbe:
    return RawBackendProbe(found, False, "1", device, "fake probe")


def _standard_registry() -> BackendRegistry:
    var reg = build_backend_registry(
        _fake(True, "hip-dev"),
        _fake(True, "vk-dev"),
        _fake(True, "xrt-dev"),
        _fake(True, "cpu-dev"),
    )
    var hip = reg.hip
    var vulkan = reg.vulkan
    hip.gpu_role = GPU_ROLE_PROBE_ONLY
    vulkan.gpu_role = GPU_ROLE_FIRST_CLASS
    return BackendRegistry(hip, vulkan, reg.xrt, reg.cpu)


def _gpu_absent_registry() -> BackendRegistry:
    var reg = build_backend_registry(
        _fake(False, ""),
        _fake(False, ""),
        _fake(True, "xrt-dev"),
        _fake(True, "cpu-dev"),
    )
    var hip = reg.hip
    var vulkan = reg.vulkan
    hip.gpu_role = GPU_ROLE_PROBE_ONLY
    vulkan.gpu_role = GPU_ROLE_FIRST_CLASS
    return BackendRegistry(hip, vulkan, reg.xrt, reg.cpu)


def _pin(label: String, actual: String, expected: String) raises:
    if actual != expected:
        raise Error(
            "A-107 pin drift at "
            + label
            + ":\n  pinned: "
            + expected
            + "\n  actual: "
            + actual
            + "\n  (a decision changed; re-pinning requires"
            " a numbers-backed slice -- A-107)"
        )


def _pin_int(label: String, actual: Int, expected: Int) raises:
    if actual != expected:
        raise Error(
            "A-107 pin drift at "
            + label
            + ": pinned "
            + String(expected)
            + ", actual "
            + String(actual)
        )


def test_battery_planner_standard_fixtures() raises:
    print("--- Battery: planner standard fixtures pinned (A-107) ---")
    var reg = _standard_registry()
    var context = standard_context()
    var fixtures = standard_fixtures()
    _pin_int("planner fixture count", len(fixtures), 12)
    var expected = List[String]()
    expected.append(_prefill_gpu_line())
    expected.append(_capped_line())
    expected.append(_overlap_line())
    expected.append(_gemm_line())
    expected.append(_gemv_gpu_line())
    expected.append(_sampling_line())
    expected.append(_attention_gpu_line())
    expected.append(_embed_line())
    expected.append(_elementwise_line())
    expected.append(_embproj_gpu_line())
    expected.append(_prefill_band_line())
    expected.append(_transfer_gpu_line())
    for i in range(len(fixtures)):
        var fixture = fixtures[i]
        var decision = plan_op(reg, context, fixture.request)
        # The A-100 coarse pins still hold underneath the
        # full-line pins (device class + backend per fixture).
        if decision.device_class != fixture.expected_device_class:
            raise Error(
                "battery: fixture "
                + fixture.name
                + " device class drifted from A-100"
            )
        if decision.backend != fixture.expected_backend:
            raise Error(
                "battery: fixture "
                + fixture.name
                + " backend drifted from A-100"
            )
        _pin(
            "planner_std/" + fixture.name,
            decision.line(),
            expected[i],
        )
    print("PASS: all 12 standard fixture decisions pinned in full")


def test_battery_planner_context_variants() raises:
    print("--- Battery: planner registry/context variants pinned ---")
    var fixtures = standard_fixtures()
    var context = standard_context()
    var fit = String(
        "FIT_A094: prefill projection GEMM with M >= 64 and"
        " >= ~0.1M MACs is the measured FIT candidate (99x"
        " vs the oracle CPU at 128x1024x1024); no GPU is"
        " placeable here [fallback: CPU (A-099"
        " FALLBACK_<NAME>)]"
    )
    var absent_expected = List[String]()
    absent_expected.append(
        String("prefill_projection -> NPU (XRT): " + fit)
    )
    absent_expected.append(_capped_line())
    absent_expected.append(_overlap_line())
    absent_expected.append(_gemm_line())
    absent_expected.append(
        String(
            "gemv -> CPU (CPU): CPU spillover: decode GEMV"
            " with no GPU; NPU stays NOT FIT per A-094"
        )
    )
    absent_expected.append(_sampling_line())
    absent_expected.append(
        String(
            "attention -> CPU (CPU): CPU spillover: no GPU"
            " can take attention"
        )
    )
    absent_expected.append(_embed_line())
    absent_expected.append(_elementwise_line())
    absent_expected.append(
        String("embedding_projection -> NPU (XRT): " + fit)
    )
    absent_expected.append(
        String(
            "prefill_projection -> NPU (XRT): CROSSOVER_A094:"
            " cubic GEMM crosses the CPU oracle between 32^3"
            " and 64^3 and the projection proxy 32x1024x1024"
            " measured 103x vs the oracle CPU; no GPU"
            " placeable [fallback: CPU (A-099"
            " FALLBACK_<NAME>)]"
        )
    )
    absent_expected.append(
        String(
            "transfer -> CPU (CPU): A017_POLICY_DELEGATE (no"
            " A-100 measured row): skip NPU (NPU present"
            " (XRT) but no NPU execution is proven yet --"
            " presence only, not placement). skip GPU (GPU"
            " unavailable: HIP absent (gpu role: probe-only),"
            " Vulkan absent (gpu role: first-class); the"
            " probe-only loser is not placed). CPU spillover:"
            " no accelerator could take this op; CPU backend"
            " available"
        )
    )
    var absent = _gpu_absent_registry()
    for i in range(len(fixtures)):
        var decision = plan_op(absent, context, fixtures[i].request)
        _pin(
            "planner_absent/" + fixtures[i].name,
            decision.line(),
            absent_expected[i],
        )
    # Unproven context: the A-095 proven path is off, so no
    # NPU decision may appear at all (A-017 honesty gate);
    # prefill falls back to the GPU optimum with estimate.
    var unproven_expected = List[String]()
    unproven_expected.append(_prefill_gpu_line())
    unproven_expected.append(_prefill_gpu_line())
    unproven_expected.append(_prefill_gpu_line())
    unproven_expected.append(_gemm_line())
    unproven_expected.append(_gemv_gpu_line())
    unproven_expected.append(_sampling_line())
    unproven_expected.append(_attention_gpu_line())
    unproven_expected.append(_embed_line())
    unproven_expected.append(_elementwise_line())
    unproven_expected.append(_embproj_gpu_line())
    unproven_expected.append(_prefill_band_line())
    unproven_expected.append(_transfer_gpu_line())
    var reg = _standard_registry()
    var unproven = PlannerContext(False)
    for i in range(len(fixtures)):
        var decision = plan_op(reg, unproven, fixtures[i].request)
        if decision.device_class == DEVICE_NPU:
            raise Error(
                "battery: unproven context placed "
                + fixtures[i].name
                + " on the NPU (A-017 honesty gate)"
            )
        _pin(
            "planner_unproven/" + fixtures[i].name,
            decision.line(),
            unproven_expected[i],
        )
    print("PASS: GPU-absent + unproven-context decisions pinned (24)")


def _stack3() -> List[LayerSpec]:
    var layers = List[LayerSpec]()
    layers.append(LayerSpec(String("blk.0"), 16 * _MB, True))
    layers.append(LayerSpec(String("blk.1"), 16 * _MB, True))
    layers.append(LayerSpec(String("blk.2"), 16 * _MB, True))
    return layers^


def _pin_plan(
    label: String,
    plan: PlacementPlan,
    ok: Bool,
    refusal: String,
    digest: UInt64,
    log: String,
) raises:
    if plan.ok != ok:
        raise Error("A-107 pin drift at " + label + ": ok flag")
    _pin(label + "/refusal", plan.refusal_reason, refusal)
    if plan.digest != digest:
        raise Error(
            "A-107 pin drift at "
            + label
            + ": digest pinned "
            + String(digest)
            + ", actual "
            + String(plan.digest)
        )
    _pin(label + "/log", plan.log_text(), log)


