def _pin_fair(
    label: String, sched: FairScheduler, summary: String, digest: UInt64
) raises:
    _pin(label + "/summary", sched.summary_line(), summary)
    if sched.digest() != digest:
        raise Error(
            "A-107 pin drift at "
            + label
            + ": digest pinned "
            + String(digest)
            + ", actual "
            + String(sched.digest())
        )


def test_battery_fairness_standard_scripts() raises:
    print("--- Battery: fairness standard scripts pinned (A-107) ---")
    var f1 = FairScheduler(String("model-a"), 1, String("model-b"), 1)
    var qa1 = 100000
    var qb1 = 100000
    for _ in range(400):
        var step = f1.serve_step(512, qa1, qb1)
        qa1 -= step.alloc_a
        qb1 -= step.alloc_b
    _pin_fair(
        "fair_equal",
        f1,
        String(
            "fairness-summary steps=400 served=100000,100000"
            " max_wait=0,0 wait_bound=1 lag_cross=0"
            " lag_bound_cross=768 jain_x1000=1000"
        ),
        UInt64(18141209263579509733),
    )
    var f2 = FairScheduler(String("model-a"), 2, String("model-b"), 1)
    var qa2 = 300000
    var qb2 = 300000
    for _ in range(400):
        var step = f2.serve_step(768, qa2, qb2)
        qa2 -= step.alloc_a
        qb2 -= step.alloc_b
    _pin_fair(
        "fair_weighted",
        f2,
        String(
            "fairness-summary steps=400 served=204800,102400"
            " max_wait=0,0 wait_bound=1 lag_cross=0"
            " lag_bound_cross=1536 jain_x1000=1000"
        ),
        UInt64(4079691411540333915),
    )
    var f3 = FairScheduler(String("huge"), 1, String("small"), 1)
    var qa3 = 1000000
    var qb3 = 0
    for s in range(1600):
        if s % 16 == 0:
            qb3 += 8
        var step = f3.serve_step(64, qa3, qb3)
        qa3 -= step.alloc_a
        qb3 -= step.alloc_b
    _pin_fair(
        "fair_adversarial",
        f3,
        String(
            "fairness-summary steps=1600 served=101600,800"
            " max_wait=0,1 wait_bound=1 lag_cross=100800"
            " lag_bound_cross=768 jain_x1000=507"
        ),
        UInt64(11754055333518584471),
    )
    var f4 = FairScheduler(String("model-a"), 1, String("model-b"), 1)
    var qb4 = 100000
    for _ in range(100):
        var step = f4.serve_step(256, 0, qb4)
        qb4 -= step.alloc_b
    var qa4 = 100000
    for _ in range(100):
        var step = f4.serve_step(256, qa4, qb4)
        qa4 -= step.alloc_a
        qb4 -= step.alloc_b
    _pin_fair(
        "fair_idle",
        f4,
        String(
            "fairness-summary steps=200 served=12800,38400"
            " max_wait=1,1 wait_bound=1 lag_cross=25600"
            " lag_bound_cross=768 jain_x1000=800"
        ),
        UInt64(13971345022146137796),
    )
    var f5 = FairScheduler(String("only"), 1, String("absent"), 1)
    var qa5 = 10000
    for _ in range(20):
        var step = f5.serve_step(512, qa5, 0)
        qa5 -= step.alloc_a
    _pin_fair(
        "fair_single",
        f5,
        String(
            "fairness-summary steps=20 served=10000,0"
            " max_wait=0,0 wait_bound=1 lag_cross=10000"
            " lag_bound_cross=768 jain_x1000=500"
        ),
        UInt64(13601686933801457156),
    )
    print("PASS: 5 fairness scripts pinned (summary + log digest)")
