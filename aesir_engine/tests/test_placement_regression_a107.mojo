def _mixed_requests() -> List[PlannerRequest]:
    var reqs = List[PlannerRequest]()
    reqs.append(PlannerRequest(OP_PREFILL_PROJECTION, 128, 1024, 1024))
    reqs.append(PlannerRequest(OP_ATTENTION, 128, 4096, 4096))
    reqs.append(PlannerRequest(OP_GEMV, 1, 4096, 4096))
    reqs.append(PlannerRequest(OP_SAMPLING, 1, 0, 131072))
    reqs.append(PlannerRequest(OP_GEMM, 32, 32, 32))
    reqs.append(
        PlannerRequest(OP_PREFILL_PROJECTION, 128, 1024, 1024, False, True)
    )
    return reqs^


def test_battery_replan_standard_scenarios() raises:
    print("--- Battery: re-planning scenarios pinned (A-107) ---")
    var reg = _standard_registry()
    var context = standard_context()
    var plan = build_generation_plan(reg, context, _mixed_requests())
    var orig = List[String]()
    orig.append(_prefill_gpu_line())
    orig.append(_attention_gpu_line())
    orig.append(_gemv_gpu_line())
    orig.append(_sampling_line())
    orig.append(_gemm_line())
    orig.append(_capped_line())
    _pin_int("replan original step count", len(plan.steps), 6)
    for i in range(len(plan.steps)):
        _pin(
            "replan_orig/" + String(i),
            plan.steps[i].decision.line(),
            orig[i],
        )
    # GPU loss after step 0: attention + GEMV spill to CPU,
    # exactly two moves, audit covers all five remaining.
    var rr_gpu = replan_remaining(
        reg, context, plan, 1, DEVICE_GPU, "VK_ERROR_DEVICE_LOST"
    )
    if rr_gpu.outcome != REPLAN_OK:
        raise Error("battery: GPU-loss re-plan outcome drifted")
    _pin(
        "replan_gpu/outcome",
        replan_outcome_name(rr_gpu.outcome),
        String("REPLANNED"),
    )
    _pin_int("replan_gpu/completed", rr_gpu.completed_count, 1)
    _pin_int("replan_gpu/remaining", rr_gpu.remaining_count, 5)
    _pin_int("replan_gpu/moved", rr_gpu.moved_count, 2)
    _pin(
        "replan_gpu/reason",
        rr_gpu.reason,
        String(
            "remaining work re-planned onto survivors of GPU"
            " after VK_ERROR_DEVICE_LOST"
        ),
    )
    var gpu_audit = List[String]()
    gpu_audit.append(
        String(
            "step 1: GPU(Vulkan) -> CPU(CPU)"
            " [VK_ERROR_DEVICE_LOST; A-103 re-plan]"
        )
    )
    gpu_audit.append(
        String(
            "step 2: GPU(Vulkan) -> CPU(CPU)"
            " [VK_ERROR_DEVICE_LOST; A-103 re-plan]"
        )
    )
    gpu_audit.append(
        String(
            "step 3: CPU(CPU) -> CPU(CPU)"
            " [VK_ERROR_DEVICE_LOST; A-103 re-plan]"
        )
    )
    gpu_audit.append(
        String(
            "step 4: CPU(CPU) -> CPU(CPU)"
            " [VK_ERROR_DEVICE_LOST; A-103 re-plan]"
        )
    )
    gpu_audit.append(
        String(
            "step 5: NPU(XRT) -> NPU(XRT)"
            " [VK_ERROR_DEVICE_LOST; A-103 re-plan]"
        )
    )
    _pin_int("replan_gpu/audit count", len(rr_gpu.audit), 5)
    for i in range(len(rr_gpu.audit)):
        _pin("replan_gpu_audit/" + String(i), rr_gpu.audit[i], gpu_audit[i])
    var gpu_steps = List[String]()
    gpu_steps.append(
        String(
            "attention -> CPU (CPU): CPU spillover: no GPU"
            " can take attention"
        )
    )
    gpu_steps.append(
        String(
            "gemv -> CPU (CPU): CPU spillover: decode GEMV"
            " with no GPU; NPU stays NOT FIT per A-094"
        )
    )
    gpu_steps.append(_sampling_line())
    gpu_steps.append(_gemm_line())
    gpu_steps.append(_capped_line())
    _pin_int("replan_gpu/step count", len(rr_gpu.steps), 5)
    for i in range(len(rr_gpu.steps)):
        _pin(
            "replan_gpu_step/" + String(i),
            rr_gpu.steps[i].decision.line(),
            gpu_steps[i],
        )
    # NPU loss before step 0 of the prefill trio: all three
    # land on the GPU survivor, exactly two moves.
    var reqs_npu = List[PlannerRequest]()
    reqs_npu.append(
        PlannerRequest(OP_PREFILL_PROJECTION, 128, 1024, 1024, False, True)
    )
    reqs_npu.append(
        PlannerRequest(OP_PREFILL_PROJECTION, 128, 1024, 1024, True, False)
    )
    reqs_npu.append(PlannerRequest(OP_PREFILL_PROJECTION, 128, 1024, 1024))
    var plan_npu = build_generation_plan(reg, context, reqs_npu)
    var rr_npu = replan_remaining(
        reg, context, plan_npu, 0, DEVICE_NPU, "KERNEL_RUN_FAILED"
    )
    if rr_npu.outcome != REPLAN_OK:
        raise Error("battery: NPU-loss re-plan outcome drifted")
    _pin_int("replan_npu/completed", rr_npu.completed_count, 0)
    _pin_int("replan_npu/remaining", rr_npu.remaining_count, 3)
    _pin_int("replan_npu/moved", rr_npu.moved_count, 2)
    _pin(
        "replan_npu/reason",
        rr_npu.reason,
        String(
            "remaining work re-planned onto survivors of NPU"
            " after KERNEL_RUN_FAILED"
        ),
    )
    var npu_audit = List[String]()
    npu_audit.append(
        String(
            "step 0: NPU(XRT) -> GPU(Vulkan)"
            " [KERNEL_RUN_FAILED; A-103 re-plan]"
        )
    )
    npu_audit.append(
        String(
            "step 1: NPU(XRT) -> GPU(Vulkan)"
            " [KERNEL_RUN_FAILED; A-103 re-plan]"
        )
    )
    npu_audit.append(
        String(
            "step 2: GPU(Vulkan) -> GPU(Vulkan)"
            " [KERNEL_RUN_FAILED; A-103 re-plan]"
        )
    )
    _pin_int("replan_npu/audit count", len(rr_npu.audit), 3)
    for i in range(len(rr_npu.audit)):
        _pin("replan_npu_audit/" + String(i), rr_npu.audit[i], npu_audit[i])
    for i in range(len(rr_npu.steps)):
        _pin(
            "replan_npu_step/" + String(i),
            rr_npu.steps[i].decision.line(),
            _prefill_gpu_line(),
        )
    # CPU loss with a CPU-only step remaining: fail closed.
    var reqs_cpu = List[PlannerRequest]()
    reqs_cpu.append(PlannerRequest(OP_EMBEDDING_LOOKUP, 128, 0, 4096))
    var plan_cpu = build_generation_plan(reg, context, reqs_cpu)
    var rr_cpu = replan_remaining(
        reg, context, plan_cpu, 0, DEVICE_CPU, "CPU_FAULT"
    )
    if rr_cpu.outcome != REPLAN_FAILED_CLOSED:
        raise Error("battery: CPU-loss re-plan no longer fails closed")
    _pin_int("replan_cpu/steps", len(rr_cpu.steps), 0)
    _pin(
        "replan_cpu/reason",
        rr_cpu.reason,
        String(
            "no survivor can take step 0 (embedding_lookup)"
            " after CPU_FAULT on CPU"
        ),
    )
    # Seeded drill: GPU loss at step 2 completes on the
    # survivors with tokens matching the control exactly.
    var drill = run_failure_drill(
        reg, context, _mixed_requests(), 4242, 2, DEVICE_GPU,
        "VK_ERROR_DEVICE_LOST",
    )
    if drill.outcome != REPLAN_OK:
        raise Error("battery: drill outcome drifted")
    if not drill.tokens_match_control:
        raise Error("battery: drill tokens no longer match control")
    _pin_int("drill/moved", drill.moved_count, 1)
    _pin_int(
        "drill/on_failed", drill.steps_on_failed_after_failure, 0
    )
    _pin(
        "drill/reason",
        drill.reason,
        String(
            "drill completed on the re-planned survivors;"
            " final tokens match the uninterrupted control"
            " exactly"
        ),
    )
    var tokens = List[Int]()
    tokens.append(4242)
    tokens.append(7768)
    tokens.append(24078)
    tokens.append(17482)
    tokens.append(29852)
    tokens.append(1215)
    _pin_int("drill/token count", len(drill.tokens), 6)
    for i in range(len(drill.tokens)):
        _pin_int(
            "drill/token " + String(i), drill.tokens[i], tokens[i]
        )
    var drill_audit = List[String]()
    drill_audit.append(
        String(
            "step 2: GPU(Vulkan) -> CPU(CPU)"
            " [VK_ERROR_DEVICE_LOST; A-103 re-plan]"
        )
    )
    drill_audit.append(
        String(
            "step 3: CPU(CPU) -> CPU(CPU)"
            " [VK_ERROR_DEVICE_LOST; A-103 re-plan]"
        )
    )
    drill_audit.append(
        String(
            "step 4: CPU(CPU) -> CPU(CPU)"
            " [VK_ERROR_DEVICE_LOST; A-103 re-plan]"
        )
    )
    drill_audit.append(
        String(
            "step 5: NPU(XRT) -> NPU(XRT)"
            " [VK_ERROR_DEVICE_LOST; A-103 re-plan]"
        )
    )
    _pin_int("drill/audit count", len(drill.audit), 4)
    for i in range(len(drill.audit)):
        _pin("drill_audit/" + String(i), drill.audit[i], drill_audit[i])
    print("PASS: re-plan originals, GPU/NPU/CPU loss + drill pinned")


def _split(
    layers: List[Int], budget: Int, pool: Int
) -> String:
    var plan = plan_layer_split(
        layers,
        LLAMA31_8B_EMBED_BYTES,
        LLAMA31_8B_OUTPUT_BYTES,
        budget,
        pool,
        _CTX,
        LLAMA31_8B_KV_HEADS,
        LLAMA31_8B_HEAD_DIM,
    )
    return plan.line()


