"""A-055: SPIR-V build pipeline.

The Wave 7 kernels in aesir_engine/shaders/*.comp are compiled at
build time by scripts/build_shaders.py (glslangValidator + spirv-val,
never fetched at runtime or build time) into the versioned in-repo
artefacts these cases pin:

  aesir_engine/shaders/SHADER_MANIFEST.json          (hashes recorded)
  aesir_engine/shaders/generated/aesir_shaders_spv.h (embedded words)

The Vulkan buffer shim consumes the generated header for vec_add
(kVecAddSpv), so the A-015 dispatch cases in this same suite execute
pipeline-built SPIR-V on the RADV device; these cases pin the
pipeline artefacts themselves. No accelerator execution is claimed
by these cases beyond that existing dispatch evidence.
"""


def _read_repo_file(rel: String) raises -> String:
    # The E-MASTER suite runs from the repository root; the fallback
    # covers running with aesir_engine/ as the working directory.
    try:
        with open("aesir_engine/" + rel, "r") as f:
            return f.read()
    except:
        with open(rel, "r") as f:
            return f.read()


def _manifest() raises -> String:
    return _read_repo_file("shaders/SHADER_MANIFEST.json")


def _header() raises -> String:
    return _read_repo_file("shaders/generated/aesir_shaders_spv.h")


def test_spirv_pipeline_manifest() raises:
    print("--- Testing SPIR-V pipeline manifest (A-055) ---")
    var manifest = _manifest()
    if "\"slice\": \"A-055\"" not in manifest:
        raise Error("manifest does not record slice A-055")
    if "\"kernel_count\": 22" not in manifest:
        raise Error("manifest kernel_count is not 22")
    if "\"deterministic\": true" not in manifest:
        raise Error("manifest does not record deterministic builds")
    if "\"target_env\": \"vulkan1.0\"" not in manifest:
        raise Error("manifest does not record the vulkan1.0 target env")
    var names = [
        "attention_decode", "elementwise", "gemv_f32", "rmsnorm",
        "rope", "sampling_greedy", "sampling_sample", "softmax", "vec_add",
        "embed_gather", "kv_append", "attention_decode_strided",
        "q4k_gemv", "q5_k_gemv", "q6_k_gemv", "q8_0_gemv",
        "q8_0_gemm", "gemm_f32", "iq1_s_gemv", "iq2_xxs_gemv",
        "iq3_xxs_gemv", "iq4_nl_gemv",
    ]
    for i in range(len(names)):
        if ("\"name\": \"" + names[i] + "\"") not in manifest:
            raise Error("manifest is missing kernel " + names[i])
    print("SPIR-V manifest (22 kernels: 13 prior + embed_gather + kv_append + attention_decode_strided registered A-066 + q8_0_gemm + gemm_f32 + 4 IQ GEMV registered A-068, deterministic): PASS")


def test_spirv_pipeline_hashes_recorded() raises:
    print("--- Testing SPIR-V pipeline recorded hashes (A-055) ---")
    var manifest = _manifest()
    # vec_add SPIR-V hash pinned to the A-015 hand-embedded module:
    # the pipeline reproduces it byte-for-byte.
    if "b228710b1f464b3aa810a4d4cb73e67f2325fdf1eabaa2ceb6b2cf73309ce15b" not in manifest:
        raise Error("vec_add spv_sha256 differs from the A-015 pinned hash")
    var hashes = [
        "53e44cae0bbf15d5381c2866b28b6493b266fb75c9a77e2a6bb47cd145c16981",
        "804583081f7299d73d96d78ce565a276f51f64db815e6756d8512860d33170ca",
        "658061666ecb1c85a9b8d2d5d7a4804ad0c47eb2c6648b92d251fad26c6e907b",
        "b23cb30bc450a41d97e447c608063a7498b5df218ac95c4702a54c1187d3c7ae",
        "5de79760b84c0ca6bbe0ce773241b5fc6a5e260c1a98e86f560e10665da50768",
        "a381ed5a989591d9854a8384c7d80ce33a9c3f04a075cd5c33cf77d71f1486db",
        "706162baf9e9194a8ea5f3e558bd6bbe00acbce026bd7cd1487b6a95e482c1cc",
    ]
    for i in range(len(hashes)):
        if hashes[i] not in manifest:
            raise Error("manifest is missing a recorded spv_sha256")
    if "\"source_sha256\"" not in manifest or "\"spv_sha256\"" not in manifest:
        raise Error("manifest lacks source/spv hash fields")
    print("SPIR-V recorded hashes (all 8 spv_sha256 present, vec_add pinned): PASS")


def test_spirv_pipeline_header_embedded() raises:
    print("--- Testing SPIR-V pipeline embedded header (A-055) ---")
    var header = _header()
    if "0x07230203u" not in header:
        raise Error("generated header lacks the SPIR-V magic word")
    if "kVecAddSpv" not in header or "kAesirShaderCount" not in header:
        raise Error("generated header lacks the vec_add array or the table")
    var consts = [
        "kAttentionDecodeSpv", "kElementwiseSpv", "kGemvF32Spv",
        "kRmsnormSpv", "kRopeSpv", "kSamplingGreedySpv", "kSamplingSampleSpv", "kSoftmaxSpv",
        "kEmbedGatherSpv", "kKvAppendSpv", "kAttentionDecodeStridedSpv",
        "kQ4kGemvSpv", "kQ5KGemvSpv", "kQ6KGemvSpv", "kQ80GemvSpv",
        "kQ80GemmSpv", "kGemmF32Spv", "kIq1SGemvSpv", "kIq2XxsGemvSpv",
        "kIq3XxsGemvSpv", "kIq4NlGemvSpv",
    ]
    for i in range(len(consts)):
        if consts[i] not in header:
            raise Error("generated header is missing " + consts[i])
    if "GENERATED by scripts/build_shaders.py" not in header:
        raise Error("generated header lacks its generation provenance")
    print("SPIR-V embedded header (22 arrays + registry table): PASS")


def test_spirv_pipeline_no_runtime_fetch() raises:
    print("--- Testing SPIR-V pipeline no-fetch discipline (A-055) ---")
    var script = _read_repo_file("../scripts/build_shaders.py")
    var banned = ["urllib", "requests", "curl", "wget", "socket", "http://", "https://"]
    for i in range(len(banned)):
        if banned[i] in script:
            raise Error("build_shaders.py contains a fetch mechanism: " + banned[i])
    if "glslangValidator" not in script or "spirv-val" not in script:
        raise Error("build_shaders.py does not drive the local toolchain")
    print("SPIR-V no-fetch discipline (local glslang/spirv-val only): PASS")


def test_spirv_pipeline_toolchain_recorded() raises:
    print("--- Testing SPIR-V pipeline toolchain record (A-055) ---")
    var manifest = _manifest()
    if "Glslang Version: 11:16.4.0" not in manifest:
        raise Error("manifest does not record the glslang version")
    if "SPIRV-Tools v2026.3" not in manifest:
        raise Error("manifest does not record the SPIRV-Tools version")
    if "\"spirv_version_word\": 65536" not in manifest:
        raise Error("manifest kernels are not SPIR-V 1.0 modules")
    print("SPIR-V toolchain record (glslang 16.4.0, SPIR-V 1.0): PASS")
