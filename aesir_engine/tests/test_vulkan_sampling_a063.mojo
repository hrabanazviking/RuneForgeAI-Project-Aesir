"""Vulkan sampling (A-063): greedy + temperature/top-k sampling
dispatched on the GPU through the A-014/A-015 Vulkan context,
judged against independent CPU references written in this file.

Parity discipline (raw-oracle law): expected values come ONLY
from the sequential Float32 CPU references below - never from
the shaders, their wrapper, or any golden generated by them.
The greedy reference is the textbook argmax with the engine's
tie policy (lowest index wins, test_greedy_tie_policy). The
stochastic reference mirrors core/sampler.mojo's draw semantics:
scale logits by temperature, keep the top-k under the stable
total order (scaled logit descending, id ascending on ties),
softmax with max-subtraction over the kept set, then draw the
first kept token whose cumulative exp mass reaches u * total
for a supplied uniform u in [0, 1) - the value RuneRNG supplies
on the engine path. Fixtures keep every logit within 15 of the
row maximum, so the CPU path's threshold pre-filter is a no-op
on them and the two distributions are the same distribution.

Acceptance (roadmap A-063): greedy token-exact vs CPU greedy on
fixtures; temperature distribution matches the sampling oracle.
The exact-u cases pin the second half token-for-token at fixed
u; the distribution case sweeps a deterministic u grid and
compares empirical frequencies against oracle probabilities.

Device-execution evidence (law 6): the selected device must be
the AMD Radeon 8060S (RADV STRIX_HALO) - llvmpipe is refused by
the identity check - and the shim dispatch counters must advance
by exactly the number of dispatches performed. On a host without
that device the cases assert fail-closed behaviour and pass as
honest-absent, matching A-014 discipline.
"""
from std.math import exp
from core.vulkan_buffers import VulkanBuffers, VulkanAllocation
from core.vulkan_sampling import VulkanSampling


def _vk_present() -> Bool:
    if not VulkanBuffers.runtime_available():
        return False
    if not VulkanBuffers.dispatch_available():
        return False
    try:
        var info = VulkanBuffers.device_info()
        if info.vendor_id != 0x1002:
            return False
        if info.device_type == 4:
            return False
        return VulkanBuffers.device_name_is_radv()
    except:
        return False


struct _Lcg:
    var state: UInt64

    def __init__(out self, seed: UInt64):
        self.state = seed

    def next(mut self) -> UInt64:
        self.state = (
            self.state * 6364136223846793005 + 1442695040888963407
        )
        return self.state >> 11

    def unit(mut self) -> Float32:
        return Float32(self.next() & 0xFFFFFF) / Float32(16777216.0)

    def val(mut self) -> Float32:
        return self.unit() * Float32(8.0) - Float32(4.0)


def _mk(*vals: Float32) -> List[Float32]:
    var out_list = List[Float32]()
    for i in range(len(vals)):
        out_list.append(vals[i])
    return out_list^


def _mki(*vals: Int) -> List[Int]:
    var out_list = List[Int]()
    for i in range(len(vals)):
        out_list.append(vals[i])
    return out_list^


def _cpu_greedy(logits: List[Float32]) -> Int:
    """Independent CPU greedy: first (lowest-index) maximum."""
    var best = 0
    for i in range(1, len(logits)):
        if logits[i] > logits[best]:
            best = i
    return best


def _ranked(
    logits: List[Float32], temperature: Float32, kept: Int,
    mut ids: List[Int], mut vals: List[Float32],
):
    """The kept set in the stable total order (scaled logit
    descending, id ascending on ties), by repeated selection of
    the best element ranked strictly after the previous pick -
    the definition of that order, written sequentially."""
    var prev_val = Float32(1.0e30)
    var prev_idx = -1
    for _ in range(kept):
        var best_idx = -1
        var best_val = Float32(-1.0e30)
        for i in range(len(logits)):
            var v = logits[i] / temperature
            var after = v < prev_val or (v == prev_val and i > prev_idx)
            if after and (best_idx < 0 or v > best_val or (v == best_val and i < best_idx)):
                best_val = v
                best_idx = i
        ids.append(best_idx)
        vals.append(best_val)
        prev_val = best_val
        prev_idx = best_idx


def _kept_count(n: Int, top_k: Int) -> Int:
    if top_k <= 0 or top_k >= n:
        return n
    return top_k


def _cpu_sample(
    logits: List[Float32], top_k: Int, temperature: Float32, u: Float32,
) -> Int:
    """Independent CPU temperature/top-k draw for uniform u."""
    var kept = _kept_count(len(logits), top_k)
    var ids = List[Int]()
    var vals = List[Float32]()
    _ranked(logits, temperature, kept, ids, vals)
    var total = Float32(0.0)
    for r in range(kept):
        total += exp(vals[r] - vals[0])
    var target = u * total
    var acc = Float32(0.0)
    for r in range(kept):
        acc += exp(vals[r] - vals[0])
        if target <= acc:
            return ids[r]
    return ids[kept - 1]


def _cpu_probs(
    logits: List[Float32], top_k: Int, temperature: Float32,
) -> List[Float32]:
    """Oracle probability per token id (0 for truncated ids)."""
    var probs = List[Float32]()
    for _ in range(len(logits)):
        probs.append(Float32(0.0))
    var kept = _kept_count(len(logits), top_k)
    var ids = List[Int]()
    var vals = List[Float32]()
    _ranked(logits, temperature, kept, ids, vals)
    var total = Float32(0.0)
    for r in range(kept):
        total += exp(vals[r] - vals[0])
    for r in range(kept):
        probs[ids[r]] = exp(vals[r] - vals[0]) / total
    return probs^


def _alloc_logits(logits: List[Float32]) raises -> VulkanAllocation:
    var l_alloc = VulkanBuffers.allocate(len(logits) * 4)
    var pl = VulkanBuffers.map(l_alloc)
    var fl = pl.unsafe_bitcast[Float32]()
    for i in range(len(logits)):
        fl.unsafe_store(i, logits[i])
    VulkanBuffers.unmap(l_alloc)
    return l_alloc^


def _alloc_out() raises -> VulkanAllocation:
    var o_alloc = VulkanBuffers.allocate(4)
    var po = VulkanBuffers.map(o_alloc)
    var fo = po.unsafe_bitcast[UInt32]()
    fo.unsafe_store(0, UInt32(0xFFFFFFFF))
    VulkanBuffers.unmap(o_alloc)
    return o_alloc^


def _read_token(o_alloc: VulkanAllocation) raises -> Int:
    var po = VulkanBuffers.map(o_alloc)
    var fo = po.unsafe_bitcast[UInt32]()
    var tok = Int(fo.unsafe_load(0))
    VulkanBuffers.unmap(o_alloc)
    return tok


def _gpu_greedy(logits: List[Float32]) raises -> Int:
    var l_alloc = _alloc_logits(logits)
    var o_alloc = _alloc_out()
    VulkanSampling.greedy(l_alloc, o_alloc, len(logits))
    var tok = _read_token(o_alloc)
    VulkanBuffers.free(l_alloc)
    VulkanBuffers.free(o_alloc)
    return tok


def _gpu_sample(
    logits: List[Float32], top_k: Int, temperature: Float32, u: Float32,
) raises -> Int:
    var l_alloc = _alloc_logits(logits)
    var o_alloc = _alloc_out()
    VulkanSampling.sample(l_alloc, o_alloc, len(logits), top_k, temperature, u)
    var tok = _read_token(o_alloc)
    VulkanBuffers.free(l_alloc)
    VulkanBuffers.free(o_alloc)
    return tok


def _lcg_logits(n: Int, seed: UInt64) -> List[Float32]:
    var lcg = _Lcg(seed)
    var logits = List[Float32]()
    for _ in range(n):
        logits.append(lcg.val())
    return logits^


def test_vulkan_sampling_greedy_oracle_parity() raises:
    print("--- Testing Vulkan sampling greedy oracle parity (A-063) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: greedy parity not run (honest-absent)")
        return
    var sizes = _mki(1, 7, 255, 256, 257, 1024, 4096, 32768)
    for s in range(len(sizes)):
        var logits = _lcg_logits(sizes[s], UInt64(0xA06301 + s * 7))
        var expected = _cpu_greedy(logits)
        var got = _gpu_greedy(logits)
        if got != expected:
            raise Error(
                "greedy parity failed at n=" + String(sizes[s])
                + ": gpu " + String(got) + " vs cpu " + String(expected)
            )
    print("Vulkan sampling greedy oracle parity (8 sizes, token-exact): PASS")


def test_vulkan_sampling_greedy_tie_policy() raises:
    print("--- Testing Vulkan sampling greedy tie policy (A-063) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: tie policy not run (honest-absent)")
        return
    var cases = List[List[Float32]]()
    cases.append(_mk(Float32(1.0), Float32(1.0), Float32(1.0), Float32(1.0)))
    cases.append(_mk(Float32(0.0), Float32(3.5), Float32(-1.0), Float32(3.5), Float32(2.0)))
    cases.append(_mk(Float32(-5.0), Float32(-2.0), Float32(-9.0)))
    cases.append(_mk(Float32(0.25), Float32(0.5)))
    var expect = _mki(0, 1, 1, 1)
    var big = List[Float32]()
    for i in range(5000):
        big.append(Float32(-1.0))
    big[4999] = Float32(7.0)
    big[123] = Float32(7.0)
    cases.append(big.copy())
    expect.append(123)
    for c in range(len(cases)):
        var got = _gpu_greedy(cases[c].copy())
        if got != expect[c]:
            raise Error(
                "greedy tie case " + String(c) + " failed: gpu "
                + String(got) + " vs expected " + String(expect[c])
            )
        var oracle = _cpu_greedy(cases[c].copy())
        if oracle != expect[c]:
            raise Error("cpu reference disagrees on tie case " + String(c))
    print("Vulkan sampling greedy tie policy (5 crafted cases, lowest index): PASS")


def _check_exact(
    logits: List[Float32], top_k: Int, temperature: Float32, us: List[Float32], tag: String,
) raises:
    for j in range(len(us)):
        var expected = _cpu_sample(logits, top_k, temperature, us[j])
        var got = _gpu_sample(logits, top_k, temperature, us[j])
        if got != expected:
            raise Error(
                "sample exact-u failed (" + tag + ", u=" + String(us[j])
                + "): gpu " + String(got) + " vs cpu " + String(expected)
            )


def test_vulkan_sampling_sample_oracle_exact() raises:
    print("--- Testing Vulkan sampling temperature/top-k exact-u oracle (A-063) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: exact-u sample not run (honest-absent)")
        return
    var us = _mk(Float32(0.0), Float32(0.13), Float32(0.31), Float32(0.5), Float32(0.67), Float32(0.83), Float32(0.97), Float32(0.999))
    var hand = _mk(Float32(2.0), Float32(-1.0), Float32(0.5), Float32(1.5), Float32(0.5), Float32(-3.0), Float32(1.5), Float32(0.0))
    _check_exact(hand, 0, Float32(1.0), us, "hand k=all T=1")
    _check_exact(hand, 3, Float32(0.5), us, "hand k=3 T=0.5")
    _check_exact(hand, 5, Float32(2.0), us, "hand k=5 T=2")
    _check_exact(hand, 1, Float32(0.7), us, "hand k=1 (greedy-equivalent)")
    var mid = _lcg_logits(64, 0xA06341)
    _check_exact(mid, 10, Float32(0.7), us, "lcg64 k=10 T=0.7")
    _check_exact(mid, 64, Float32(1.0), us, "lcg64 k=all T=1")
    var wide = _lcg_logits(1000, 0xA06342)
    var us5 = _mk(Float32(0.07), Float32(0.29), Float32(0.5), Float32(0.71), Float32(0.93))
    _check_exact(wide, 40, Float32(1.3), us5, "lcg1000 k=40 T=1.3")
    print("Vulkan sampling temperature/top-k exact-u oracle (7 fixtures x u grid, token-exact): PASS")


def _freq_check(
    logits: List[Float32], top_k: Int, temperature: Float32, draws: Int, tol: Float32, tag: String,
) raises -> List[Float32]:
    var probs = _cpu_probs(logits, top_k, temperature)
    var counts = List[Int]()
    for _ in range(len(logits)):
        counts.append(0)
    for j in range(draws):
        var u = (Float32(j) + Float32(0.5)) / Float32(draws)
        var tok = _gpu_sample(logits, top_k, temperature, u)
        counts[tok] += 1
    var freqs = List[Float32]()
    for i in range(len(logits)):
        var f = Float32(counts[i]) / Float32(draws)
        freqs.append(f)
        var delta = f - probs[i]
        if delta < Float32(0.0):
            delta = -delta
        if delta > tol:
            raise Error(
                "distribution failed (" + tag + ", token " + String(i)
                + "): freq " + String(f) + " vs oracle p " + String(probs[i])
            )
        if probs[i] == Float32(0.0) and counts[i] != 0:
            raise Error("distribution failed (" + tag + "): truncated token " + String(i) + " was drawn")
    return freqs^


def test_vulkan_sampling_temperature_distribution() raises:
    print("--- Testing Vulkan sampling temperature distribution (A-063) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: distribution not run (honest-absent)")
        return
    var logits = _mk(Float32(2.0), Float32(1.0), Float32(0.5), Float32(0.0), Float32(-0.5), Float32(-1.0))
    _ = _freq_check(logits, 3, Float32(1.0), 400, Float32(0.02), "k=3 T=1")
    var cold = _freq_check(logits, 0, Float32(0.4), 200, Float32(0.03), "k=all T=0.4")
    var hot = _freq_check(logits, 0, Float32(2.5), 200, Float32(0.03), "k=all T=2.5")
    if not (cold[0] > hot[0]):
        raise Error("temperature flattening failed: argmax freq must fall as T rises")
    print("Vulkan sampling temperature distribution (800 deterministic-u draws, oracle probs): PASS")


def test_vulkan_sampling_rejection() raises:
    print("--- Testing Vulkan sampling rejection (A-063) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: rejection cases not run (honest-absent)")
        return
    var logits = _lcg_logits(64, 0xA06351)
    var l_alloc = _alloc_logits(logits)
    var o_alloc = _alloc_out()
    var tiny = VulkanBuffers.allocate(8)
    var big = VulkanBuffers.allocate(16385 * 4)
    var g_before = VulkanSampling.greedy_dispatch_count()
    var s_before = VulkanSampling.sample_dispatch_count()
    var rejected = 0
    try:
        VulkanSampling.greedy(l_alloc, o_alloc, 0)
    except:
        rejected += 1
    try:
        VulkanSampling.greedy(tiny, o_alloc, 64)
    except:
        rejected += 1
    try:
        VulkanSampling.sample(l_alloc, o_alloc, 64, 10, Float32(0.0), Float32(0.5))
    except:
        rejected += 1
    try:
        VulkanSampling.sample(l_alloc, o_alloc, 64, 10, Float32(-1.0), Float32(0.5))
    except:
        rejected += 1
    try:
        VulkanSampling.sample(l_alloc, o_alloc, 64, -1, Float32(1.0), Float32(0.5))
    except:
        rejected += 1
    try:
        VulkanSampling.sample(l_alloc, o_alloc, 64, 10, Float32(1.0), Float32(-0.1))
    except:
        rejected += 1
    try:
        VulkanSampling.sample(l_alloc, o_alloc, 64, 10, Float32(1.0), Float32(1.0))
    except:
        rejected += 1
    # Effective kept count cap: n = 2048 with top_k = 0 keeps the
    # whole row (2048 > 1024) and must raise before dispatch.
    try:
        VulkanSampling.sample(big, o_alloc, 2048, 0, Float32(1.0), Float32(0.5))
    except:
        rejected += 1
    # Vocab bound: n = 16385 exceeds the stochastic kernel bound.
    try:
        VulkanSampling.sample(big, o_alloc, 16385, 1, Float32(1.0), Float32(0.5))
    except:
        rejected += 1
    VulkanBuffers.free(l_alloc)
    VulkanBuffers.free(o_alloc)
    VulkanBuffers.free(tiny)
    VulkanBuffers.free(big)
    if rejected != 9:
        raise Error("rejection failed: " + String(rejected) + " of 9 invalid calls raised")
    if VulkanSampling.greedy_dispatch_count() != g_before:
        raise Error("rejection leaked a greedy dispatch")
    if VulkanSampling.sample_dispatch_count() != s_before:
        raise Error("rejection leaked a sample dispatch")
    print("Vulkan sampling rejection (9 invalid calls raise, no dispatch): PASS")


def test_vulkan_sampling_dispatch_evidence() raises:
    print("--- Testing Vulkan sampling dispatch evidence (A-063) ---")
    if not _vk_present():
        print("Vulkan UNAVAILABLE: dispatch evidence not run (honest-absent)")
        return
    var logits = _lcg_logits(512, 0xA06361)
    var g_before = VulkanSampling.greedy_dispatch_count()
    var s_before = VulkanSampling.sample_dispatch_count()
    var base_bytes = VulkanBuffers.live_bytes()
    var base_count = VulkanBuffers.live_count()
    for _ in range(3):
        _ = _gpu_greedy(logits)
    for _ in range(2):
        _ = _gpu_sample(logits, 20, Float32(0.9), Float32(0.42))
    if VulkanSampling.greedy_dispatch_count() - g_before != 3:
        raise Error("greedy dispatch counter did not advance by exactly 3")
    if VulkanSampling.sample_dispatch_count() - s_before != 2:
        raise Error("sample dispatch counter did not advance by exactly 2")
    if VulkanBuffers.live_bytes() != base_bytes:
        raise Error("sampling loop leaked device bytes")
    if VulkanBuffers.live_count() != base_count:
        raise Error("sampling loop leaked buffers")
    print("Vulkan sampling dispatch evidence (greedy +3, sample +2, accounting exact): PASS")
