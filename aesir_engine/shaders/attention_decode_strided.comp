#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// A-066: decode attention over a KV cache whose slot stride
// (max_len) exceeds the live length (kv_len). The A-062 kernel
// derives the cache row stride from kv_len itself, which is
// only correct when the cache is exactly kv_len slots deep;
// a decode loop appends into a max_len-deep cache, so the
// stride must travel separately. Everything else mirrors
// attention_decode.comp: one invocation per (query head,
// head_dim lane), GQA mapping h / kv_per_query, scores scaled
// by 1/sqrt(head_dim), max-subtraction softmax. The A-062
// kernel and its pinned SPIR-V are untouched.
// A-074: same subgroup-cooperative score path as
// attention_decode.comp (subgroupAdd over strided head_dim
// partials when head_dim is a multiple of the subgroup size).
// Compiled per-kernel at --target-env vulkan1.1.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer QBuf { float q[]; };
layout(std430, set = 0, binding = 1) readonly buffer KBuf { float k[]; };
layout(std430, set = 0, binding = 2) readonly buffer VBuf { float v[]; };
layout(std430, set = 0, binding = 3) buffer OBuf { float o[]; };
layout(push_constant) uniform Push {
    uint head_dim;
    uint kv_len;
    uint num_heads;
    uint kv_per_query;
    uint max_len;
} pc;
float dot_serial(uint qbase, uint kbase) {
    float s = 0.0;
    for (uint d = 0; d < pc.head_dim; d++) {
        s += q[qbase + d] * k[kbase + d];
    }
    return s;
}
float dot_coop(uint qbase, uint kbase) {
    float s = 0.0;
    for (uint d = gl_SubgroupInvocationID; d < pc.head_dim;
         d += gl_SubgroupSize) {
        s += q[qbase + d] * k[kbase + d];
    }
    return subgroupAdd(s);
}
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_heads * pc.head_dim) { return; }
    uint head = idx / pc.head_dim;
    uint lane = idx % pc.head_dim;
    uint kv_head = head / pc.kv_per_query;
    uint qbase = head * pc.head_dim;
    float scale = 1.0 / sqrt(float(pc.head_dim));
    // A-074: cooperative score path. Invocations are head-major, so
    // when head_dim is a multiple of the subgroup size a subgroup
    // never straddles a head boundary and subgroupAdd returns the
    // full dot product to every lane in it. The score accumulation
    // ORDER changes (strided partials + subgroup tree) inside the
    // origin slices' filed parity bounds. Any other head_dim takes
    // the original serial path, byte-for-byte the pre-A-074 math.
    bool coop = (pc.head_dim % gl_SubgroupSize) == 0u;
    float row_max = -1.0 / 0.0;
    for (uint t = 0; t < pc.kv_len; t++) {
        uint kbase = (kv_head * pc.max_len + t) * pc.head_dim;
        float score;
        if (coop) { score = dot_coop(qbase, kbase); }
        else { score = dot_serial(qbase, kbase); }
        row_max = max(row_max, score * scale);
    }
    float denom = 0.0;
    float acc = 0.0;
    for (uint t = 0; t < pc.kv_len; t++) {
        uint kbase = (kv_head * pc.max_len + t) * pc.head_dim;
        float score;
        if (coop) { score = dot_coop(qbase, kbase); }
        else { score = dot_serial(qbase, kbase); }
        float w = exp(score * scale - row_max);
        denom += w;
        acc += w * v[kbase + lane];
    }
    o[idx] = acc / denom;
}
