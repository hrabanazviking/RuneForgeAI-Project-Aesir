#version 450
// A-068 dense F32 GEMM kernel (prefill): Y[t, row] = sum_k
// W[row * cols + k] * X[t * cols + k] for t in [0, tokens),
// row in [0, rows). The batched generalisation of the A-055
// gemv_f32 foundation kernel, with the A-056 workgroup shape:
// one workgroup of 256 invocations per (row, token) pair,
// dispatched as (rows, tokens, 1), strided partial sums reduced
// through shared memory. X is the row-major [tokens][cols]
// activation batch, Y the row-major [tokens][rows] output batch.
// A tokens == 1 dispatch computes the same per-row sums as
// gemv_f32 up to accumulation order (the GEMV kernel sums
// serially in one invocation; this kernel tree-reduces).
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer WBuf { float w[]; };
layout(std430, set = 0, binding = 1) readonly buffer XBuf { float x[]; };
layout(std430, set = 0, binding = 2) buffer YBuf { float y[]; };
layout(push_constant) uniform Push { uint cols; uint rows; uint tokens; } pc;
shared float sdata[256];
void main() {
    uint row = gl_WorkGroupID.x;
    uint tok = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    if (row >= pc.rows || tok >= pc.tokens) { return; }
    uint w0 = row * pc.cols;
    uint x0 = tok * pc.cols;
    float partial = 0.0;
    for (uint k = tid; k < pc.cols; k += 256u) {
        partial += w[w0 + k] * x[x0 + k];
    }
    sdata[tid] = partial;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (tid < stride) { sdata[tid] += sdata[tid + stride]; }
        barrier();
    }
    if (tid == 0u) { y[tok * pc.rows + row] = sdata[0]; }
}
