#version 450
// A-055 foundation kernel (Wave 7, for A-061): elementwise ops over
// float arrays selected by the push-constant mode:
//   mode 0: y[i] = silu(a[i])            (single input)
//   mode 1: y[i] = a[i] * b[i]           (mul)
//   mode 2: y[i] = a[i] + b[i]           (add / residual)
//   mode 3: y[i] = silu(a[i]) * b[i]     (gated SiLU, SwiGLU shape)
// The element count guards every invocation so non-multiple sizes
// are exact, exactly as in vec_add.comp (A-015).
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ABuf { float a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuf { float b[]; };
layout(std430, set = 0, binding = 2) buffer YBuf { float y[]; };
layout(push_constant) uniform Push { uint n; uint mode; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    if (pc.mode == 0u) {
        float v = a[i];
        y[i] = v / (1.0 + exp(-v));
    } else if (pc.mode == 1u) {
        y[i] = a[i] * b[i];
    } else if (pc.mode == 2u) {
        y[i] = a[i] + b[i];
    } else {
        float v = a[i];
        y[i] = (v / (1.0 + exp(-v))) * b[i];
    }
}
